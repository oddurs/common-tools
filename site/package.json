{
	"name": "common-tools",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5371 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5371 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"test": "vitest run",
		"tokens": "node ../packages/common-ui/build.mjs",
		"film": "node scripts/film.js",
		"record": "node scripts/film.js record",
		"shot": "node scripts/film.js shot",
		"glyphs": "node scripts/film.js glyphs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"playwright-core": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.28.1"
}
