#!/bin/sh
set -eu

# Gives local builds one stable code-signing identity. An ad hoc signature names only the exact
# binary, so macOS treats every rebuild as a new app and its Screen Recording switch stops applying.
# Signed with this identity, a rebuild keeps the grant. Run once per Mac; scripts/task build uses it
# when it's there, and every Common Tools repo can share it. macOS asks for your password once, to
# trust the certificate for code signing.

name="Common Tools Local Signing"
keychain="$HOME/Library/Keychains/login.keychain-db"

if security find-identity -v -p codesigning | grep -q "\"$name\""; then
    echo "==> $name is already set up"
    exit 0
fi

dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
# Only protects the export between two commands here, so a throwaway one is enough.
pass="$(uuidgen)"

cat >"$dir/cert.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $name
[ext]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning
EOF

echo "==> creating $name"
# macOS's own openssl, because the PKCS#12 that OpenSSL 3 writes by default fails `security import`.
/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$dir/cert.cnf" \
    -keyout "$dir/key.pem" -out "$dir/cert.pem"
/usr/bin/openssl pkcs12 -export -inkey "$dir/key.pem" -in "$dir/cert.pem" -out "$dir/identity.p12" \
    -passout "pass:$pass"
security import "$dir/identity.p12" -k "$keychain" -P "$pass" -T /usr/bin/codesign

echo "==> trusting it for code signing; macOS asks for your password"
security add-trusted-cert -r trustRoot -p codeSign -k "$keychain" "$dir/cert.pem"

echo "==> clearing Common Shot's Screen Recording entry, which names an ad hoc build"
tccutil reset ScreenCapture com.oddurs.commonshot

echo "==> done. Run scripts/task build, open the app, and allow Screen Recording one last time."
