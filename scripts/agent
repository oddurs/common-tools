#!/bin/sh
set -eu

# The workflow: one unit of work, one worktree, one branch, one PR, merged automatically.
# Commands: doctor start check commit pr ship sync done list

root="$(git rev-parse --show-toplevel)"
main_checkout="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir | xargs dirname)"
# Worktrees are named after the GitHub repository, not the local folder, so paths match the docs
# on every machine. Without an origin, the folder name will do.
origin_url="$(git -C "$root" remote get-url origin 2>/dev/null || :)"
repo="$(basename "${origin_url:-$main_checkout}" .git)"
worktrees="$(dirname "$main_checkout")/.worktrees/$repo"

die() {
    echo "agent: $*" >&2
    exit 1
}

default_branch() {
    ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)" || {
        git remote set-head origin --auto >/dev/null 2>&1 || die "cannot resolve origin's default branch; is 'origin' set?"
        ref="$(git symbolic-ref refs/remotes/origin/HEAD)"
    }
    echo "${ref#refs/remotes/origin/}"
}

current_branch() { git rev-parse --abbrev-ref HEAD; }

# The full check, recorded against HEAD when the tree is clean, so the pre-push hook can skip running
# the same check again on exactly the commit being pushed.
check_and_record() {
    record="$(git rev-parse --git-dir)/agent-checked"
    if [ -z "$(git status --porcelain)" ] && [ "$(cat "$record" 2>/dev/null || :)" = "$(git rev-parse HEAD)" ]; then
        echo "==> $(git rev-parse --short HEAD) already passed the check"
        return
    fi
    "$root/scripts/task" check --changed
    if [ -z "$(git status --porcelain)" ]; then
        git rev-parse HEAD >"$record"
    fi
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
doctor)
    problems=0
    report() {
        echo "  ✗ $*"
        problems=$((problems + 1))
    }
    echo "==> checking tools"
    for tool in git gh swift node pnpm; do
        if command -v "$tool" >/dev/null 2>&1; then echo "  ✓ $tool"; else report "$tool not found on PATH"; fi
    done
    if gh auth status >/dev/null 2>&1; then echo "  ✓ gh authenticated"; else report "gh not authenticated: run 'gh auth login'"; fi
    if swift format --version >/dev/null 2>&1; then echo "  ✓ swift format"; else report "swift format unavailable: install Swift 6 or later"; fi
    if [ -d "$root/site/node_modules" ]; then echo "  ✓ site dependencies"; else report "site dependencies missing: run 'pnpm install' in site/"; fi
    echo "==> checking repository"
    if [ "$(git config core.hooksPath || true)" = ".githooks" ]; then
        echo "  ✓ hooks path"
    else
        echo "  … setting core.hooksPath to .githooks"
        git config core.hooksPath .githooks
    fi
    if [ -z "$(git status --porcelain)" ]; then echo "  ✓ clean tree"; else report "uncommitted changes in $(pwd)"; fi
    [ "$problems" -eq 0 ] || die "$problems problem(s) found"
    echo "==> all good"
    ;;
start)
    branch="${1:-}"
    echo "$branch" | grep -Eq '^(feat|fix|chore|docs|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$' ||
        die "branch must look like <type>/<slug>, type one of feat fix chore docs perf refactor test (got '$branch')"
    path="$worktrees/$branch"
    git show-ref --verify --quiet "refs/heads/$branch" && die "branch $branch already exists"
    [ -e "$path" ] && die "worktree path $path already exists"
    base="$(default_branch)"
    echo "==> fetching origin"
    git fetch --quiet origin
    echo "==> creating $branch from origin/$base at $path"
    mkdir -p "$(dirname "$path")"
    git worktree add --quiet -b "$branch" "$path" "origin/$base"
    git -C "$path" branch --quiet --unset-upstream 2>/dev/null || :
    echo "cd $path"
    ;;
check)
    exec "$root/scripts/task" check --changed
    ;;
commit)
    [ $# -ge 1 ] || die "usage: scripts/agent commit '<type>(scope): subject' [body]"
    echo "==> committing"
    if [ $# -ge 2 ]; then git commit -m "$1" -m "$2"; else git commit -m "$1"; fi
    ;;
pr)
    branch="$(current_branch)"
    [ "$branch" != "$(default_branch)" ] || die "on the default branch; start a branch with 'scripts/agent start'"
    echo "==> checking"
    check_and_record
    merged="the pull request for $branch already merged; put new commits on a new branch ('scripts/agent start'), then run 'scripts/agent done' here"
    state="$(gh pr view "$branch" --json state --jq .state 2>/dev/null || :)"
    case "$state" in
    MERGED) die "$merged" ;;
    CLOSED) die "the pull request for $branch was closed; reopen it or start a new branch" ;;
    OPEN)
        # Auto-merge lands the head it already has once checks pass, so it could merge before new
        # commits arrive. Hold it while pushing; it's enabled again below, for the new head.
        echo "==> pausing auto-merge while pushing"
        gh pr merge "$branch" --disable-auto >/dev/null 2>&1 || :
        [ "$(gh pr view "$branch" --json state --jq .state)" != "MERGED" ] || die "$merged"
        ;;
    esac
    echo "==> pushing $branch"
    git push --quiet --force-with-lease -u origin "$branch"
    if [ "$state" = "OPEN" ]; then
        echo "==> pull request already open"
    else
        echo "==> opening pull request"
        # The first commit names the unit of work; later ones are fixes along the way.
        gh pr create --fill-first "$@"
    fi
    # Only ever merge what is checked out here. The API can report the old head for a few seconds
    # after a push, so a mismatch is read again before it counts.
    want="$(git rev-parse HEAD)"
    tries=0
    while [ "$(gh pr view "$branch" --json headRefOid --jq .headRefOid)" != "$want" ]; do
        tries=$((tries + 1))
        [ "$tries" -lt 10 ] || die "the pull request's head is not this branch's HEAD ($want) after $tries reads; push again"
        sleep 3
    done
    title="$(gh pr view "$branch" --json title --jq .title)"
    echo "$title" | grep -Eq '^(feat|fix|chore|docs|perf|refactor|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*[^.]$' ||
        die "pull request title '$title' is not a Conventional Commit; fix it with gh pr edit --title"
    number="$(gh pr view "$branch" --json number --jq .number)"
    # Squash-merges by itself once the required check passes, under the pull request's title.
    echo "==> enabling auto-merge"
    gh pr merge "$branch" --auto --squash --subject "$title (#$number)"
    gh pr view "$branch" --json url --jq .url
    ;;
ship)
    # Commit (when given a message), open the pull request with auto-merge, rebase it while CI runs
    # only when it must, and clean up once it merges. Stops on a failed check or a conflict.
    branch="$(current_branch)"
    base="$(default_branch)"
    [ "$branch" != "$base" ] || die "on the default branch; start a branch with 'scripts/agent start'"
    # ship ["<subject>" ["<why>"]] [--body-file <pr.md> ...]: flags go to gh pr create.
    if [ $# -ge 1 ] && [ "${1#--}" = "$1" ]; then
        subject="$1"
        shift
        git add -A
        if [ $# -ge 1 ] && [ "${1#--}" = "$1" ]; then
            git commit --quiet -m "$subject" -m "$1"
            shift
        else
            git commit --quiet -m "$subject"
        fi
    fi
    [ -z "$(git status --porcelain)" ] || die "uncommitted changes; pass a commit message or commit them first"
    # Branch protection doesn't require a branch to be up to date, so GitHub merges on a green
    # check whatever $base did meanwhile, and $base's own CI checks each merge once it lands.
    # Rebasing on every move restarted CI for nothing. This rebases only when the pull request
    # can't merge as it is, or when $base gained a change to an area this branch changes too:
    # then the check runs on what will land, not on what the branch started from.
    merged() { [ "$(gh pr view "$branch" --json state --jq .state)" = "MERGED" ]; }
    # The areas both this branch and $base changed since they forked. Each list names an area
    # once, so an area in both shows up twice.
    overlap() {
        mine="$("$root/scripts/task" areas "origin/$base")"
        theirs="$("$root/scripts/task" areas "$(git merge-base HEAD "origin/$base")..origin/$base")"
        # shellcheck disable=SC2086 # one area per word
        printf '%s\n' $mine $theirs | sort | uniq -d | tr '\n' ' '
    }
    git fetch --quiet origin
    shared="$(overlap)"
    if [ -n "$shared" ]; then
        echo "==> rebasing onto $base, which changed ${shared% } too"
        git rebase --quiet "origin/$base" || die "conflicts with $base; resolve them, then run 'scripts/agent ship' again"
    fi
    "$0" pr "$@"
    echo "==> waiting for $branch to merge"
    seen="$(git rev-parse "origin/$base")"
    while :; do
        pr_state="$(gh pr view "$branch" --json state,mergeable,mergeStateStatus --jq '"\(.state) \(.mergeable) \(.mergeStateStatus)"')"
        read -r state mergeable merge_state <<EOF
$pr_state
EOF
        [ "$state" = "MERGED" ] && break
        [ "$state" = "CLOSED" ] && die "the pull request was closed without merging"
        git fetch --quiet origin
        reason=""
        if git merge-base --is-ancestor "origin/$base" HEAD; then
            # Already on top of $base: a conflict GitHub still reports is from before the last push.
            :
        elif [ "$mergeable" = "CONFLICTING" ]; then
            reason="it conflicts with $base"
        elif [ "$merge_state" = "BEHIND" ]; then
            reason="branch protection wants it up to date with $base"
        elif [ "$(git rev-parse "origin/$base")" != "$seen" ]; then
            seen="$(git rev-parse "origin/$base")"
            shared="$(overlap)"
            if [ -n "$shared" ]; then
                reason="$base changed ${shared% } too"
            else
                echo "==> $base moved, outside what this branch changes; leaving it as it is"
            fi
        fi
        if [ -n "$reason" ]; then
            # Hold auto-merge first, so the head checked against the old $base can't land while
            # the rebased one is checked; `pr` checks it, pushes it, and turns auto-merge back on.
            gh pr merge "$branch" --disable-auto >/dev/null 2>&1 || :
            # The move may be this pull request landing, between the state read and the fetch.
            merged && break
            echo "==> rebasing onto $base: $reason"
            git rebase --quiet "origin/$base" || die "conflicts with $base; resolve them, then run 'scripts/agent ship' again"
            "$0" pr
            seen="$(git rev-parse "origin/$base")"
        fi
        # Only the checks that gate the merge: auto-merge goes ahead past any other failure.
        # gh pr checks exits 1 on a failure, 8 while pending; "no checks reported" means not started yet.
        checks=0
        report="$(gh pr checks "$branch" --required 2>&1)" || checks=$?
        case "$report" in *"no checks reported"* | *"no required checks reported"*) checks=8 ;; esac
        [ "$checks" -eq 1 ] && die "a check failed: $(gh pr view "$branch" --json url --jq .url)/checks"
        sleep 15
    done
    echo "==> merged"
    "$0" done
    ;;
sync)
    base="$(default_branch)"
    echo "==> rebasing $(current_branch) onto origin/$base"
    git fetch --quiet origin
    git rebase "origin/$base"
    ;;
done)
    branch="$(current_branch)"
    base="$(default_branch)"
    [ "$branch" != "$base" ] || die "run 'done' from the branch's worktree"
    state="$(gh pr view "$branch" --json state --jq .state 2>/dev/null)" || die "no pull request found for $branch"
    [ "$state" = "MERGED" ] || die "pull request for $branch is $state, not MERGED"
    path="$(pwd)"
    main="$(git rev-parse --path-format=absolute --git-common-dir | xargs dirname)"
    echo "==> removing worktree $path"
    git -C "$main" worktree remove "$path"
    echo "==> deleting local branch $branch"
    git -C "$main" branch --quiet -D "$branch"
    git -C "$main" worktree prune
    git -C "$main" fetch --quiet --prune origin
    # Where the primary checkout's $base was before this merge: what an install compares against.
    old="$(git -C "$main" rev-parse --verify --quiet "refs/heads/$base")" || old="$(git -C "$main" rev-parse "origin/$base")"
    # Bring the primary checkout up to date, unless someone is working in it.
    if [ "$(git -C "$main" rev-parse --abbrev-ref HEAD)" = "$base" ] && [ -z "$(git -C "$main" status --porcelain)" ]; then
        git -C "$main" merge --quiet --ff-only "origin/$base" && echo "==> $main is at origin/$base"
    else
        echo "==> left $main as it is: not on $base, or it has changes"
    fi
    # Installs the merged apps into /Applications in the background, on a Mac that opted in
    # (scripts/install). This worktree is gone by now, so it's the primary checkout's copy.
    # From the primary checkout: this worktree is gone, and a shell started in it complains.
    cd "$main"
    if [ -x "$main/scripts/install" ]; then
        "$main/scripts/install" --after-merge "$old" || echo "==> the install was not queued; see above"
    fi
    echo "==> done; cd $main"
    ;;
list)
    git worktree list | while read -r path _ rest; do
        branch="$(echo "$rest" | sed -n 's/.*\[\(.*\)\].*/\1/p')"
        state="-"
        [ -n "$branch" ] && state="$(gh pr view "$branch" --json state --jq .state 2>/dev/null || echo "no PR")"
        printf '%-50s %-40s %s\n' "$path" "${branch:-detached}" "$state"
    done
    ;;
*)
    echo "usage: scripts/agent {doctor|start <type>/<slug>|check|commit <msg> [body]|pr [--draft]|ship [<msg> [body]] [--body-file f]|sync|done|list}" >&2
    exit 2
    ;;
esac
