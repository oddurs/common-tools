#!/bin/sh
set -eu

# The one seam CI and the git hooks call, for every part of the monorepo.
#
#   scripts/task <verb> [area ...] [--changed] [--filter=<test>] [--universal]
#
# Verbs: fmt fmt:check lint test build package run smoke cover check. Areas: site, kit
# (packages/CommonKit), or an app by its slug (apps/<slug>); none means all of them, and --changed
# means only what differs from origin/main (CommonKit changes count for every app, since they all
# depend on it). An app builds for this Mac's architecture; --universal adds the other, and package
# always does, since a release is what runs on both.

cd "$(dirname "$0")/.."
root="$(pwd)"

verb="${1:-}"
[ $# -gt 0 ] && shift

all_apps() { ls "$root/apps" 2>/dev/null || :; }

# A field of one app from apps.json. plutil reads JSON, so no other tool is needed.
app_field() { plutil -extract "$1.$2" raw -o - "$root/apps.json"; }

# What differs from origin/main, committed or not; or, with changed_range=<from>..<to>, only what
# those commits changed.
changed_files() {
    if [ -n "${changed_range:-}" ]; then
        git diff --name-only "$changed_range"
        return
    fi
    base="${changed_base:-$(git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD)}"
    git diff --name-only "$base"
    git diff --name-only
    git ls-files --others --exclude-standard
}

changed_areas() {
    changed_files | sort -u | awk -v apps="$(all_apps | tr '\n' ' ')" '
        # Workflows, root documents and docs/, the cairn items of the roadmap, the hooks, and the scripts
        # other than this one change nothing a check tests: the workflow tooling, releases, and
        # generated icons, which are committed.
        /^scripts\/task$/    { site = 1; kit = 1; everyapp = 1; next }
        /^scripts\//         { next }
        /^\.githooks\//      { next }
        /^\.github\//        { next }
        /^docs\//            { next }
        /^cairn\//           { next }
        /^[^\/]+\.md$/       { next }
        /^LICENSE$/          { next }
        /^site\//            { site = 1; next }
        # The site reads the family list in CommonKit and the Common UI tokens, and shows the images in
        # each app docs folder.
        /^packages\//        { kit = 1; everyapp = 1; site = 1; next }
        /^apps\/[^\/]+\/docs\// { site = 1 }
        /^apps\/[^\/]+\//    { split($0, p, "/"); app[p[2]] = 1; next }
        /^shared\//          { everyapp = 1; next }
                             { site = 1; kit = 1; everyapp = 1 }
        END {
            if (site) print "site"
            if (kit) print "kit"
            n = split(apps, list, " ")
            for (i = 1; i <= n; i++) if (everyapp || app[list[i]]) print list[i]
        }'
}

existing_areas() {
    while read -r area; do
        if [ "$area" = site ]; then
            echo site
        elif [ "$area" = kit ]; then
            if [ -d packages/CommonKit ]; then echo kit; fi
        elif [ -d "apps/$area" ]; then
            echo "$area"
        fi
    done
}

areas=""
changed=0
filter=""
universal=0
for arg in "$@"; do
    case "$arg" in
    --changed) changed=1 ;;
    --universal) universal=1 ;;
    --filter=*) filter="${arg#--filter=}" ;;
    *) areas="$areas $arg" ;;
    esac
done
if [ "$changed" -eq 1 ]; then
    # Only areas that exist: a change at the root names every area, present or not.
    areas="$(changed_areas | existing_areas | tr '\n' ' ')"
    [ -n "$areas" ] || { echo "==> nothing changed"; exit 0; }
elif [ -z "$areas" ]; then
    areas="site $([ -d packages/CommonKit ] && echo kit) $(all_apps | tr '\n' ' ')"
fi

# Command Line Tools ship Swift Testing outside the default search paths; Xcode does not need this.
test_flags() {
    dev="$(xcode-select -p)"
    case "$dev" in
    */CommandLineTools)
        fw="$dev/Library/Developer/Frameworks"
        lib="$dev/Library/Developer/usr/lib"
        printf '%s\n' -Xswiftc -F -Xswiftc "$fw" -Xlinker -F -Xlinker "$fw" \
            -Xlinker -rpath -Xlinker "$fw" -Xlinker -rpath -Xlinker "$lib"
        ;;
    esac
}

# macOS ties permissions and login items to the signature. The shared development identity keeps
# them across rebuilds; scripts/dev-cert makes it. Outside CI a build without it is an error: an
# ad-hoc copy gets grants of its own, and the next properly signed build is left with a switch in
# System Settings that shows on and doesn't apply. CI never holds a grant, so it signs ad hoc.
sign() {
    identity="Common Tools Development"
    if [ -n "${CI:-}" ]; then
        echo "==> signing $1 ad-hoc (CI)"
        codesign --force --sign - --identifier "$2" --options runtime "$1"
    elif security find-identity -v -p codesigning | grep -q "\"$identity\""; then
        echo "==> signing $1 with '$identity'"
        codesign --force --sign "$identity" --identifier "$2" --options runtime "$1"
    else
        echo "error: no valid '$identity' signing identity in the keychain." >&2
        echo "       Run scripts/dev-cert once on this Mac, then build again." >&2
        exit 1
    fi
}

# Lint and test build the same debug configuration: SwiftPM rebuilds every module when the flags
# change, so lint's build, with the tests in it, is the one test runs, and the next lint is
# incremental instead of starting over.
debug_flags() {
    printf '%s\n' -Xswiftc -warnings-as-errors
    test_flags
}

swift_package() {
    # $1 = verb, in a package directory
    case "$1" in
    fmt) swift format --in-place --recursive Package.swift Sources Tests ;;
    fmt:check) swift format lint --strict --recursive Package.swift Sources Tests ;;
    lint)
        swift format lint --strict --recursive Package.swift Sources Tests
        # shellcheck disable=SC2046
        swift build --build-tests $(debug_flags)
        ;;
    # shellcheck disable=SC2046
    test) swift test $(debug_flags) ${filter:+--filter "$filter"} ;;
    cover)
        # Line coverage from a test run. CommonKit's lines show in an app's report too, since the
        # app's tests run them.
        # shellcheck disable=SC2046
        swift test $(test_flags) --enable-code-coverage ${filter:+--filter "$filter"}
        bin="$(swift build --show-bin-path)"
        xcrun llvm-cov report -instr-profile "$bin/codecov/default.profdata" \
            -ignore-filename-regex='/Tests/|/\.build/' "$bin"/*.xctest/Contents/MacOS/*
        ;;
    esac
}

site() {
    cd "$root/site"
    [ -d node_modules ] || pnpm install --frozen-lockfile
    case "$1" in
    fmt) pnpm exec prettier --write . ;;
    fmt:check) pnpm exec prettier --check . ;;
    lint)
        pnpm exec prettier --check .
        pnpm run --silent check
        ;;
    test) pnpm exec vitest run ;;
    build)
        pnpm exec vite build
        # Every app has a page, published or on the way; without one its links point nowhere.
        for slug in $(all_apps); do
            [ -f "build/$slug/index.html" ] || { echo "site: no page was built for $slug" >&2; exit 1; }
        done
        ;;
    package | run | smoke | cover) echo "    (nothing to $1 for the site)" ;;
    check) site lint && site test && site build ;;
    esac
}

kit() {
    cd "$root/packages/CommonKit"
    case "$1" in
    fmt | fmt:check | lint | test | cover) swift_package "$1" ;;
    build) swift build -c release ;;
    package | run | smoke) echo "    (nothing to $1 for CommonKit)" ;;
    check) kit lint && kit test ;;
    esac
}

app() {
    # $1 = slug, $2 = verb
    slug="$1"
    name="$(app_field "$slug" NAME)"
    executable="$(app_field "$slug" TARGET)"
    bundle_id="$(app_field "$slug" BUNDLE)"
    asset="$(app_field "$slug" ASSET)"
    tools="$(app_field "$slug" TOOLS)"
    out="$root/build/$slug"
    bundle="$out/$name.app"
    cd "$root/apps/$slug"
    min_macos="$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' Resources/Info.plist)"
    case "$2" in
    fmt | fmt:check | lint | test | cover) swift_package "$2" ;;
    smoke)
        # Launch the built app and see it stay up. A resource the build forgot or a crash at startup
        # is what unit tests can't catch. Run from inside the bundle, so Bundle.main is the app.
        [ -d "$bundle" ] || app "$slug" build
        echo "==> launching $name for 5 seconds"
        "$bundle/Contents/MacOS/$executable" &
        pid=$!
        sleep 5
        if ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid" && status=0 || status=$?
            echo "smoke: $name quit within 5 seconds (status $status)" >&2
            exit 1
        fi
        kill "$pid"
        wait "$pid" || :
        echo "==> $name stayed up"
        ;;
    build)
        # One build per architecture, joined with lipo: `--arch a --arch b` needs Xcode's build
        # system, which Command Line Tools lack. Only a release needs both, and each one is a
        # whole release compile.
        archs="$(uname -m)"
        [ "$universal" -eq 0 ] || archs="arm64 x86_64"
        dirs=""
        for arch in $archs; do
            triple="$arch-apple-macosx$min_macos"
            echo "==> building $name for $arch"
            swift build -c release --triple "$triple"
            dirs="$dirs $(swift build -c release --triple "$triple" --show-bin-path)"
        done
        echo "==> assembling $bundle"
        rm -rf "$bundle"
        mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
        # shellcheck disable=SC2086
        lipo -create $(for dir in $dirs; do echo "$dir/$executable"; done) -output "$bundle/Contents/MacOS/$executable"
        cp Resources/Info.plist "$bundle/Contents/"
        # A development build names the commit it was built from, for scripts/dev status and the
        # Settings footer. CI's builds, releases among them, stay exactly as they were.
        if [ -z "${CI:-}" ]; then
            commit="$(git rev-parse HEAD)"
            [ -z "$(git status --porcelain -- . "$root/packages" "$root/shared")" ] || commit="$commit-dirty"
            plutil -insert CommonToolsCommit -string "$commit" "$bundle/Contents/Info.plist"
        fi
        cp Resources/AppIcon.icns "$bundle/Contents/Resources/"
        # The Common Tools section of Settings shows every app's icon from here.
        cp -R "$root/shared/CommonTools" "$bundle/Contents/Resources/"
        sign "$bundle" "$bundle_id"
        for tool in $tools; do
            # shellcheck disable=SC2046
            lipo -create $(for dir in $dirs; do echo "$dir/$tool"; done) -output "$out/$tool"
            sign "$out/$tool" "$tool"
        done
        ;;
    package)
        # What a release publishes. The names carry no version; the site links each release's tag.
        # Built again here, universal: the bundle check and run leave holds this Mac's arch only.
        universal=1
        app "$slug" build
        # Signed with a Developer ID and notarized when the environment has one; otherwise it says
        # so and the build's signature stays (docs/signing.md).
        "$root/scripts/notarize" "$bundle"
        for tool in $tools; do "$root/scripts/notarize" "$out/$tool"; done
        echo "==> packaging $name into dist/$slug/"
        rm -rf "$root/dist/$slug"
        mkdir -p "$root/dist/$slug"
        # ditto keeps the bundle's signature and extended attributes intact. The zip is what the
        # install script and the Homebrew cask fetch; the disk image is for downloading by hand.
        ditto -c -k --keepParent "$bundle" "$root/dist/$slug/$asset.zip"
        for tool in $tools; do ditto -c -k "$out/$tool" "$root/dist/$slug/$tool.zip"; done
        "$root/scripts/dmg" "$bundle" "$root/dist/$slug/$asset.dmg"
        "$root/scripts/notarize" "$root/dist/$slug/$asset.dmg"
        (cd "$root/dist/$slug" && for file in *.zip *.dmg; do shasum -a 256 "$file" >"$file.sha256"; done && ls -l)
        ;;
    run)
        app "$slug" build
        echo "==> relaunching $name"
        # By process name: a fresh build isn't registered with Launch Services yet.
        if pgrep -x "$executable" >/dev/null; then
            pkill -x "$executable"
            while pgrep -x "$executable" >/dev/null; do sleep 0.2; done
        fi
        open "$bundle"
        ;;
    check) app "$slug" lint && app "$slug" test && app "$slug" build ;;
    esac
}

case "$verb" in
areas)
    # The areas a change touches: `areas <base>` against a ref, `areas <from>..<to>` for what those
    # commits changed, or `areas --all`.
    case "${1:-}" in
    --all) printf '%s\n' site kit $(all_apps) ;;
    *..*)
        # A pipe would hide git's failure, and no areas means nothing to check.
        for end in "${1%%..*}" "${1#*..}"; do
            git rev-parse --verify --quiet "$end^{commit}" >/dev/null || { echo "task: no commit '$end'" >&2; exit 2; }
        done
        changed_range="$1" changed_areas | existing_areas
        ;;
    *) changed_base="$(git merge-base "${1:-origin/main}" HEAD)" changed_areas | existing_areas ;;
    esac
    exit 0
    ;;
fmt | fmt:check | lint | test | build | package | run | smoke | cover | check) ;;
*)
    echo "usage: scripts/task {fmt|fmt:check|lint|test|build|package|run|smoke|cover|check} [site|kit|<app> ...] [--changed] [--filter=<test>] [--universal]" >&2
    exit 2
    ;;
esac

for area in $areas; do
    echo "==> $verb $area"
    case "$area" in
    site) (site "$verb") ;;
    kit) (kit "$verb") ;;
    *)
        [ -d "apps/$area" ] || { echo "task: no area '$area'" >&2; exit 2; }
        (app "$area" "$verb")
        ;;
    esac
done
